NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/poster_maker
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
CORS_ORIGINS=http://localhost:3000
AI_MODE=gemini            # gemini | fake
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_MODERATION_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
STORAGE_MODE=cloudinary   # cloudinary | memory (memory = tests only, lost on restart)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
WORKER_CONCURRENCY=2
RENDER_TIMEOUT_MS=60000
GENERATION_RATE_LIMIT=10
LOG_LEVEL=info
