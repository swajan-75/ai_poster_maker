{
  "name": "@poster/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "prebuild": "npm run build --prefix ../../packages/shared",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "smoke": "tsx --env-file=.env scripts/smoke-generate.ts",
    "make-admin": "tsx --env-file=.env scripts/make-admin.ts",
    "backfill-usage": "tsx --env-file=.env scripts/backfill-usage.ts",
    "thumbnails": "tsx scripts/render-thumbnails.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@poster/shared": "^0.1.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer": "^24.43.1",
    "sharp": "^0.35.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
