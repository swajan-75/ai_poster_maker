{
  "name": "ai-poster-maker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "jsdom": "^25.0.1",
    "vite": "^7.3.6"
  },
  "scripts": {
    "build": "npm run build -w @poster/shared && npm run build -w @poster/api && npm run build -w @poster/web",
    "dev": "concurrently -n shared,api,web -c blue,green,magenta \"npm run dev -w @poster/shared\" \"npm run dev -w @poster/api\" \"npm run dev -w @poster/web\"",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  }
}
